# WasteVisor backend environment variable template. The app reads process environment only.
# Supply AWS credentials through the standard AWS SDK credential chain (for example an IAM role).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
DEMO_MODE=true
DB_PATH=./wastevisor.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VISION_MAX_RETRIES=1
MAX_UPLOAD_SIZE_BYTES=5242880

